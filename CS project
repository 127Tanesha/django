# Specific Impulse Calculator
def specific_impulse_calculator():
    st.title("Specific Impulse Calculator")
    with st.container():
        st.markdown('<div class="scrollable-container">', unsafe_allow_html=True)

        thrust = st.number_input("Thrust (N)", min_value=0.0)
        flow_rate = st.number_input("Propellant Mass Flow Rate (kg/s)", min_value=0.0)
        
        if st.button("Compute Specific Impulse"):
            try:
                g0 = 9.81
                Isp = thrust / (flow_rate * g0)
                st.write(f"Specific Impulse: {Isp:.2f} seconds")
            except ValueError:
                st.error("Please enter valid numeric values.")

        if st.button("Back to Menu"):
            main_menu()

        st.markdown('</div>', unsafe_allow_html=True)

# Orbital Velocity Calculator
def orbital_velocity_calculator():
    st.title("Orbital Velocity")
    with st.container():
        st.markdown('<div class="scrollable-container">', unsafe_allow_html=True)

        radius = st.number_input("Orbital Radius (m)", min_value=0.0)
        
        if st.button("Compute Orbital Velocity"):
            try:
                mu = 398600  # Gravitational parameter for Earth
                velocity = math.sqrt(mu / radius)
                st.write(f"Orbital Velocity: {velocity:.2f} m/s")
            except ValueError:
                st.error("Please enter valid numeric values.")
        
        if st.button("Back to Menu"):
            main_menu()

        st.markdown('</div>', unsafe_allow_html=True)

