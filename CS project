# Kepler's Laws Calculator
def kepler_laws_calculator():
    st.title("Kepler's Laws")
    with st.container():
        st.markdown('<div class="scrollable-container">', unsafe_allow_html=True)

        law_choice = st.radio("Choose Kepler's Law", ["Orbital Period", "Orbital Radius"])
        
        if law_choice == "Orbital Period":
            compute_orbital_period()
        elif law_choice == "Orbital Radius":
            compute_orbital_radius()

        st.markdown('</div>', unsafe_allow_html=True)

def compute_orbital_period():
    st.write("Orbital Period Calculation: Kepler's Third Law")
    period = st.number_input("Orbital Period (s)", min_value=0.0)
    if st.button("Compute Orbital Period"):
        try:
            mu = 398600  # Gravitational parameter for Earth
            T = 2 * math.pi * math.sqrt(period**3 / mu)
            st.write(f"Orbital Period: {T / 3600:.2f} hours")
        except ValueError:
            st.error("Please enter valid numeric values.")
    if st.button("Back to Menu"):
        main_menu()

def compute_orbital_radius():
    st.write("Orbital Radius Calculation: Kepler's Third Law")
    radius = st.number_input("Orbital Radius (m)", min_value=0.0)
    if st.button("Compute Orbital Radius"):
        try:
            mu = 398600  # Gravitational parameter for Earth
            radius = (mu * period**2 / (4 * math.pi**2))**(1/3)
            st.write(f"Orbital Radius: {radius:.2f} meters")
        except ValueError:
            st.error("Please enter valid numeric values.")
    if st.button("Back to Menu"):
        main_menu()

if __name__ == "__main__":
    main_menu()
