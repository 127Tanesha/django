import streamlit as st
import math

# Add custom CSS for scrollable containers
st.markdown("""
    <style>
    .scrollable-container {
        max-height: 400px;
        overflow-y: scroll;
        padding-right: 10px;
    }
    </style>
""", unsafe_allow_html=True)

# Main menu
def main_menu():
    st.title("Aerospace Calculators")
    st.write("Select a calculator from the list below:")
    
    options = [
        "Delta-V Calculator",
        "Thrust-to-Weight Ratio",
        "Specific Impulse Calculator",
        "Orbital Velocity",
        "Escape Velocity",
        "Time of Flight",
        "Fuel Efficiency",
        "Kepler's Laws"
    ]
    
    selection = st.selectbox("Choose a calculator", options)
    
    if selection == "Delta-V Calculator":
        delta_v_calculator()
    elif selection == "Thrust-to-Weight Ratio":
        thrust_to_weight_calculator()
    elif selection == "Specific Impulse Calculator":
        specific_impulse_calculator()
    elif selection == "Orbital Velocity":
        orbital_velocity_calculator()
    elif selection == "Escape Velocity":
        escape_velocity_calculator()
    elif selection == "Time of Flight":
        time_of_flight_calculator()
    elif selection == "Fuel Efficiency":
        fuel_efficiency_calculator()
    elif selection == "Kepler's Laws":
        kepler_laws_calculator()

# Delta-V Calculator
def delta_v_calculator():
    st.title("Delta-V Calculator")
    with st.container():
        st.markdown('<div class="scrollable-container">', unsafe_allow_html=True)
        
        Isp = st.number_input("Specific Impulse (Isp) [s]", min_value=0.0)
        m_initial = st.number_input("Initial Mass (kg)", min_value=0.0)
        m_final = st.number_input("Final Mass (kg)", min_value=0.0)
        
        if st.button("Compute Delta-V"):
            try:
                g0 = 9.81
                delta_v = Isp * g0 * math.log(m_initial / m_final)
                st.write(f"Delta-V: {delta_v:.2f} m/s")
            except ValueError:
                st.error("Please enter valid numeric values.")

        if st.button("Back to Menu"):
            main_menu()

        st.markdown('</div>', unsafe_allow_html=True)

# Thrust-to-Weight Ratio
def thrust_to_weight_calculator():
    st.title("Thrust-to-Weight Ratio")
    with st.container():
        st.markdown('<div class="scrollable-container">', unsafe_allow_html=True)

        thrust = st.number_input("Thrust (N)", min_value=0.0)
